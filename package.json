{
  "name": "dsh-netxops",
  "version": "0.1.50",
  "description": "DeepSeek Harness Netx Ops: ops/topology + IM delivery + session export + knowledge-base MANIFEST/_skills + localSkills",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/agent-tools.js",
    "./tools-ops": "./lib/agent-tools-ops.js",
    "./tools-nms": "./lib/agent-tools-nms.js",
    "./tools-common": "./lib/agent-tools-common.js",
    "./tools-topology": "./lib/agent-tools-topology.js",
    "./tools-biz-monitor": "./lib/agent-tools-biz-monitor.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/index.js",
    "lib/agent-tools.js",
    "lib/agent-tools-ops.js",
    "lib/agent-tools-nms.js",
    "lib/agent-tools-common.js",
    "lib/agent-tools-topology.js",
    "lib/agent-tools-biz-monitor.js",
    "lib/client.js",
    "presets/",
    "cordis.patch.yml",
    "cordis.bundle.patch.yml",
    "docs/",
    "examples/",
    "scripts/",
    "README.md",
    "LICENSE",
    ".npmrc"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "netx",
    "ops",
    "nms",
    "agent-preset"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansjone/netxops.git"
  },
  "bugs": {
    "url": "https://github.com/hansjone/netxops/issues"
  },
  "homepage": "https://github.com/hansjone/netxops#readme",
  "scripts": {
    "bundle": "bun run scripts/gen-preset-patch.mjs && bun run scripts/build-host.mjs && bun run scripts/build-client.mjs",
    "bundle:host": "bun run scripts/build-host.mjs",
    "bundle:client": "bun run scripts/build-client.mjs",
    "gen:preset-patch": "bun run scripts/gen-preset-patch.mjs",
    "link:peers": "node scripts/link-dsh-peers.mjs --profile desktop",
    "link:peers:ps1": "powershell -NoProfile -File ./scripts/link-dsh-peers.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "typescript": "^5.8.0"
  }
}
