    "dry_run": {
     "type": "boolean",
     "default": false
    },
    "pad": {
     "type": "number",
     "default": 280,
     "description": "Gap between sink hull and parked batch."
    },
    "detect_max_units": {
     "type": "integer",
     "minimum": 20,
     "maximum": 300,
     "default": 120
    }
