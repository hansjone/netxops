    },
    "time_from": {
     "type": "string",
     "description": "ISO time; filters last_seen_at >="
    },
    "time_to": {
     "type": "string",
     "description": "ISO time; filters last_seen_at <="
    },
    "page": {
     "type": "integer",
     "minimum": 1,
     "default": 1
    },
    "page_size": {
     "type": "integer",
     "minimum": 1,
     "maximum": 500,
     "default": 50
    }
   },
   "required": [],
   "type": "object",
   "additionalProperties": false
  }
 },
 {
