{
  "name": "dsh-netxops",
  "version": "0.1.70",
  "description": "Network operations, topology and monitoring for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/agent-tools.js",
    "./tools-ops": "./lib/agent-tools-ops.js",
    "./tools-nms": "./lib/agent-tools-nms.js",
    "./tools-common": "./lib/agent-tools-common.js",
    "./tools-topology": "./lib/agent-tools-topology.js",
    "./tools-biz-monitor": "./lib/agent-tools-biz-monitor.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.bundle.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/",
    "lib/index.js",
    "lib/agent-tools.js",
    "lib/agent-tools-ops.js",
    "lib/agent-tools-nms.js",
    "lib/agent-tools-common.js",
    "lib/agent-tools-topology.js",
    "lib/agent-tools-biz-monitor.js",
    "lib/client.js",
    "presets/netxops/PERSONA.md",
    "presets/netxops/preset.yml",
    "presets/netxops/skills/",
    "cordis.patch.yml",
    "cordis.bundle.patch.yml",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "netx",
    "ops",
    "nms",
    "agent-preset"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansjone/netxops.git"
  },
  "bugs": {
    "url": "https://github.com/hansjone/netxops/issues"
  },
  "homepage": "https://github.com/hansjone/netxops#readme",
  "scripts": {
    "bundle": "bun run scripts/build-host.mjs && bun run scripts/build-client.mjs",
    "bundle:host": "bun run scripts/build-host.mjs",
    "bundle:client": "bun run scripts/build-client.mjs",
    "gen:preset-patch": "bun run scripts/gen-preset-patch.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "preview:client": "bun scripts/preview-client.mjs",
    "link:peers": "node scripts/link-dsh-peers.mjs --profile desktop",
    "link:peers:ps1": "powershell -NoProfile -File ./scripts/link-dsh-peers.ps1",
    "test": "bun test test tests",
    "release:check": "node scripts/verify-release.mjs",
    "release:pack": "node scripts/pack-release.mjs",
    "test:release": "node --test test/release-package.test.mjs",
    "prepublishOnly": "node scripts/verify-release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.1",
    "@types/react": "~18.3.1",
    "typescript": "^5.8.0"
  }
}
