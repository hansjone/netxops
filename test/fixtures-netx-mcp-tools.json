     "type": "boolean",
     "default": false,
     "description": "Legacy: prefer both portals sinkable. Default false so CN/core eyes (portals stay on root) are not deprioritized."
    },
    "prefer_core_eye": {
     "type": "boolean",
     "default": true,
     "description": "Alias of prefer_top_eye. Prefer core/agg eyes top→down before access rings."
    },
    "prefer_top_eye": {
     "type": "boolean",
     "default": true,
     "description": "Prefer dual_unit portals top→down: core–core, core–agg, agg–agg, then maximize movable coverage."
